.search-icon {
  position: absolute;
  left: 18px;
  top: 50%;
  transform: translateY(-50%);
  color: #999;
}

.tag-cloud {
  display: flex;
  justify-content: center;
  gap: 8px;
  margin-bottom: 28px;
  flex-wrap: wrap;
}
.tag-chip {
  padding: 4px 12px;
  border-radius: 14px;
  background: #fef9c3;
  color: #a16207;
  font-size: 12px;
  cursor: pointer;
  border: none;
  transition: all .15s;
}
.tag-chip:hover { background: #fde047; }
.tag-cnt {
  background: rgba(0,0,0,.08);
  padding: 0 6px;
  border-radius: 8px;
  margin-left: 4px;
  font-size: 10px;
}

.post-empty {
  text-align: center;
  color: #999;
  padding: 40px 20px;
  font-size: 16px;
}

/* ── 系列分类栏（2026-10-04）── */
.list-layout {
  display: flex;
  gap: 24px;
  align-items: flex-start;
  max-width: 1100px;
  margin: 0 auto;
}
.series-side {
  /* 不再固定 168px：分类名变长（如「新人不用手·一键脚本」）会换行错位。
     改成按内容自适应，宽度上限留给文章列表。 */
  flex: 0 0 auto;
  min-width: 148px;
  max-width: 220px;
  position: sticky;
  top: 20px;
  background: #fff;
  border: 1px solid #f0f0f0;
  border-radius: 14px;
  padding: 12px 10px;
}
.series-side-title {
  font-size: 12px;
  color: #999;
  font-weight: 700;
  letter-spacing: .08em;
